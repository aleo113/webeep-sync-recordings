# Absolute path to cloned PoliWebex repository
POLIWEBEX_PATH=/absolute/path/to/Transcriber/PoliWebex

# Optional explicit binaries if they are not in PATH (e.g. nvm/custom installs)
NODE_BIN=
ARIA2C_BIN=
FFMPEG_BIN=

# In Flatpak terminals without DISPLAY, run PoliWebex on host to show GUI login.
# Defaults to auto (enabled only when DISPLAY is missing and flatpak-spawn exists).
POLIWEBEX_RUN_ON_HOST=

# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Optional fixed language code (it, en, ...). Leave empty for autodetect.
WHISPER_LANGUAGE=

# Transcription quality profile: fast, balanced, or accurate.
# balanced uses the primary model and retries only uncertain regions with medium.
WHISPER_PROFILE=balanced
WHISPER_RETRY_MODEL=medium
WHISPER_VAD_FILTER=true
WHISPER_MAX_RETRY_FRACTION=0.25

# Optional backend overrides. Defaults to CUDA/float16 when available, otherwise CPU/int8.
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# Number of retrieved PDF chunks to include in prompt pack
TOP_K_MATCHES=12

# Notes generation mode: transcript-only, prompt-pack or api
NOTES_MODE=api

# API note generation uses the locally authenticated Codex CLI.
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT_SECONDS=900
MAX_SLIDE_IMAGES=8

# Select useful frames from lecture videos without overloading Codex.
VIDEO_FRAMES_ENABLED=true
VIDEO_FRAME_INTERVAL_SECONDS=60
MAX_VIDEO_FRAMES=8
MAX_TOTAL_IMAGES=12

# For URL batches, overlap one upcoming download with current processing.
PREFETCH_DOWNLOADS=true
